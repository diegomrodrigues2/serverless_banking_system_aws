{
  "info": {
    "_postman_id": "double-entry-ledger-v1",
    "name": "Double-Entry Ledger API",
    "description": "Testes completos da API do Double-Entry Ledger (AWS Serverless Banking).\n\nEndpoints:\n- POST /entries   — cria lançamento contábil\n- POST /reversals — cria reversão de lançamento\n- GET  /balances/{account_id}  — consulta saldo\n- GET  /statements/{account_id} — extrato paginado\n\nAmbientes disponíveis: local, dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "entry_id",
      "value": "",
      "description": "Preenchido automaticamente após POST /entries"
    },
    {
      "key": "external_id",
      "value": "",
      "description": "Preenchido automaticamente após POST /entries"
    }
  ],
  "item": [
    {
      "name": "Entries",
      "item": [
        {
          "name": "POST /entries — Criar lançamento válido (BRL)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gera external_id único para garantir idempotência",
                  "pm.collectionVariables.set('external_id', pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Resposta tem status success', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('data contém entry_id', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.property('entry_id');",
                  "  pm.collectionVariables.set('entry_id', body.data.entry_id);",
                  "  // Salva o external_id do primeiro POST para o teste de idempotência",
                  "  pm.collectionVariables.set('first_external_id', pm.collectionVariables.get('external_id'));",
                  "});",
                  "",
                  "pm.test('entry_type é STANDARD', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.entry_type).to.eql('STANDARD');",
                  "});",
                  "",
                  "pm.test('postings têm 2 itens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.postings).to.have.lengthOf(2);",
                  "});",
                  "",
                  "pm.test('metadata contém request_id', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.metadata).to.have.property('request_id');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_id\": \"{{external_id}}\",\n  \"postings\": [\n    {\n      \"account_id\": \"acc_customer_001\",\n      \"amount\": 10000,\n      \"currency\": \"BRL\",\n      \"direction\": \"DEBIT\"\n    },\n    {\n      \"account_id\": \"acc_revenue_001\",\n      \"amount\": 10000,\n      \"currency\": \"BRL\",\n      \"direction\": \"CREDIT\"\n    }\n  ],\n  \"metadata\": {\n    \"order_id\": \"order-001\",\n    \"description\": \"Pagamento de pedido\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/entries",
              "host": ["{{base_url}}"],
              "path": ["entries"]
            }
          }
        },
