    {
      "name": "Reversals",
      "item": [
        {
          "name": "POST /reversals — Reverter lançamento existente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Usa o entry_id salvo pelo teste de criação",
                  "const entryId = pm.collectionVariables.get('entry_id');",
                  "if (!entryId) { throw new Error('entry_id não encontrado. Execute POST /entries primeiro.'); }",
                  "pm.collectionVariables.set('reversal_external_id', pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('entry_type é REVERSAL', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.entry_type).to.eql('REVERSAL');",
                  "});",
                  "",
                  "pm.test('postings têm direções invertidas', () => {",
                  "  const body = pm.response.json();",
                  "  const directions = body.data.postings.map(p => p.direction);",
                  "  pm.expect(directions).to.include('DEBIT');",
                  "  pm.expect(directions).to.include('CREDIT');",
                  "});",
                  "",
                  "pm.test('data contém entry_id', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.property('entry_id');",
                  "  pm.collectionVariables.set('reversal_entry_id', body.data.entry_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_entry_id\": \"{{entry_id}}\",\n  \"external_id\": \"{{reversal_external_id}}\",\n  \"metadata\": {\n    \"reason\": \"Estorno solicitado pelo cliente\",\n    \"ticket_id\": \"ticket-001\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/reversals",
              "host": ["{{base_url}}"],
              "path": ["reversals"]
            }
          }
        },
        {
          "name": "POST /reversals — Idempotência (mesmo external_id)",
          "event": [
